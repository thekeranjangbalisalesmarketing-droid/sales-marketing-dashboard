# Salin nilai ke Vercel Environment Variables (Settings -> Environment Variables)

# Gemini AI API Key (untuk Real-Time Sales Recovery & Asisten)
VITE_GEMINI_API_KEY=

# Firebase Firestore Config (untuk sinkronisasi real-time antar perangkat)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
